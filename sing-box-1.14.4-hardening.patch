+install_kyong_shortcut() {
+  local menu="$WORK_DIR/kyong-menu.sh" pending
+  if [[ ! $0 -ef $menu ]]; then
+    pending=$(mktemp "$WORK_DIR/.kyong-menu.XXXXXXXX") || return 1
+    if ! install -m 0700 "$0" "$pending" || ! mv -fT -- "$pending" "$menu"; then
+      rm -f -- "$pending"
+      return 1
+    fi
+  fi
+  ln -sfnT "$menu" /usr/bin/sb
+}
+
+if [[ ${1:-} == --kyong-install-shortcut ]]; then
+  install_kyong_shortcut
+  exit $?
+fi
+
+kyong_cloudflared() (
+  set -o pipefail
+  local dest=$1 version=2026.10.7 arch digest
+  case $(uname -m) in
+    x86_64) arch=amd64; digest=1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872 ;;
+    aarch64) arch=arm64; digest=3df43aedc9ff291d1735b5cb576cb97e0b157488796db2e32b28aecabb445775 ;;
+    *) return 1 ;;
+  esac
+  curl -q -fsSL --retry 3 --proto '=https' --proto-redir '=https' \
+    "https://github.com/cloudflare/cloudflared/releases/download/$version/cloudflared-linux-$arch" -o "$dest" &&
+    printf '%s  %s\n' "$digest" "$dest" | sha256sum -c - &&
+    chmod 0755 "$dest" || { rm -f -- "$dest"; return 1; }
+)
+
+kyong_warp_register() (
+  set -o pipefail
+  local script
+  script=$(mktemp "$TEMP_DIR/warp.XXXXXXXX") || exit 1
+  trap 'rm -f -- "$script"' EXIT
+  curl -q -fsSL --max-time 15 --proto '=https' --proto-redir '=https' \
+    'https://gitlab.com/fscarmen/warp/-/raw/8372a6a7f51a0f359b693f37ca8abcda54f29f09/api.sh' -o "$script" &&
+    printf '%s  %s\n' '5d70c0d7a239b1e1deb1a0b7369f66f19237180f32b4ee7036ddf5754970e48c' "$script" |
+      sha256sum -c - >&2 &&
+    timeout 15 bash "$script" --register
+)
+
+kyong_reality_public() (
+  set -o pipefail
+  local key=$1 public
+  [[ $key =~ ^[A-Za-z0-9_-]{43}$ ]] || exit 1
+  public=$(
+    { printf '\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20'
+      printf '%s=' "$key" | tr '_-' '/+' | base64 -d; } |
+      openssl pkey -inform DER -pubout -outform DER |
+      tail -c 32 | base64 -w0 | tr '+/' '-_' | tr -d '='
+  ) || exit 1
+  [[ $public =~ ^[A-Za-z0-9_-]{43}$ ]] || exit 1
+  printf '%s\n' "$public"
+)
 
